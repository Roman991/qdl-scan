<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="NewScan.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tb="using:H.NotifyIcon"
    mc:Ignorable="d"
    Title="Scan App">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title bar personalizzata in stile WinUI: icona app + titolo, trascinabile -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="40" Background="Transparent" Padding="12,0">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Image Source="ms-appx:///Assets/app.ico" Width="18" Height="18" />
                <TextBlock Text="Scan App" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" />
            </StackPanel>
        </Grid>

        <!-- Icona nella system tray: bridge sempre disponibile in background -->
        <tb:TaskbarIcon
            x:Name="TrayIcon"
            ToolTipText="Scan App — bridge scanner per il browser"
            NoLeftClickDelay="True">
            <tb:TaskbarIcon.IconSource>
                <tb:GeneratedIconSource
                    Text="S"
                    Foreground="White"
                    Background="#0078D4" />
            </tb:TaskbarIcon.IconSource>
            <tb:TaskbarIcon.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem x:Name="OpenMenuItem" Text="Apri" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem x:Name="ExitMenuItem" Text="Esci" />
                </MenuFlyout>
            </tb:TaskbarIcon.ContextFlyout>
        </tb:TaskbarIcon>

        <ScrollViewer Grid.Row="1" Padding="28,24,28,28">
            <StackPanel Spacing="18" MaxWidth="640" HorizontalAlignment="Stretch">

                <!-- Intestazione -->
                <StackPanel Spacing="2">
                    <TextBlock
                        Text="Acquisizione documenti da scanner verso il browser (WIA)"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <!-- Stato connessione browser -->
                <InfoBar
                    x:Name="StatusBar"
                    IsOpen="True"
                    IsClosable="False"
                    Severity="Informational"
                    Title="In attesa"
                    Message="Nessun browser collegato." />

                <!-- Card impostazioni scanner -->
                <Border
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20">
                    <StackPanel Spacing="16">

                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="6">
                                <TextBlock Text="Scanner" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <ComboBox
                                    x:Name="ScannerCombo"
                                    HorizontalAlignment="Stretch"
                                    PlaceholderText="Nessuno scanner trovato"
                                    SelectionChanged="ScannerCombo_SelectionChanged" />
                            </StackPanel>
                            <Button
                                Grid.Column="1"
                                VerticalAlignment="Bottom"
                                Click="RefreshScanners_Click"
                                ToolTipService.ToolTip="Aggiorna elenco scanner">
                                <FontIcon Glyph="&#xE72C;" FontSize="16" />
                            </Button>
                        </Grid>

                        <Grid ColumnSpacing="16" RowSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Spacing="6">
                                <TextBlock Text="Risoluzione (DPI)" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <ComboBox x:Name="DpiCombo" HorizontalAlignment="Stretch" />
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="1" Spacing="6">
                                <TextBlock Text="Colore" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <ComboBox x:Name="ColorCombo" HorizontalAlignment="Stretch" DisplayMemberPath="Label" />
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0" Spacing="6">
                                <TextBlock Text="Origine" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <ComboBox
                                    x:Name="SourceCombo"
                                    HorizontalAlignment="Stretch"
                                    DisplayMemberPath="Label"
                                    SelectionChanged="SourceCombo_SelectionChanged" />
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="1" Spacing="6" VerticalAlignment="Bottom">
                                <TextBlock Text="Fronte/retro" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <ToggleSwitch x:Name="DuplexToggle" IsEnabled="False" OnContent="Sì" OffContent="No" />
                            </StackPanel>
                        </Grid>

                        <!-- La scansione e l'interruzione sono guidate dal browser:
                             qui si configura soltanto lo scanner. -->
                        <TextBlock
                            Text="Scansione e interruzione si avviano dal browser. Qui configuri lo scanner una sola volta."
                            Style="{StaticResource CaptionTextBlockStyle}"
                            TextWrapping="Wrap"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- Impostazioni avanzate -->
                <Expander Header="Impostazioni avanzate" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <StackPanel Spacing="14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="Avvia all'accesso a Windows" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock
                                    Text="Mantiene il bridge sempre disponibile dopo il login."
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <ToggleSwitch
                                x:Name="AutostartToggle"
                                Grid.Column="1"
                                Toggled="AutostartToggle_Toggled" />
                        </Grid>
                        <TextBlock
                            x:Name="EndpointText"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Expander>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
