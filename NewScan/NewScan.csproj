<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>NewScan</RootNamespace>
    <AssemblyName>NewScan</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- .NET Framework 4.8: incluso in Windows 10/11 (o distribuito via Windows Update),
         nessun runtime aggiuntivo da installare separatamente sulla macchina di destinazione
         (a differenza della precedente build WinUI 3 / .NET 10 + Windows App SDK). -->

    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <AssemblyTitle>Scan App</AssemblyTitle>
    <Product>ScanAppForWeb</Product>
    <Version>2.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Fleck" Version="1.2.0" />
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

  <ItemGroup>
    <!-- Richiesto per il late binding COM (dynamic) usato da WiaScannerService. -->
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\app.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
