<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <runtime>
    <!-- Abbinato a dpiAwareness=PerMonitorV2 in app.manifest: consente a WinForms di
         ridimensionare i controlli sui cambi di DPI (multi-monitor), .NET Framework 4.7+. -->
    <AppContextSwitchOverrides value="Switch.System.Windows.Forms.EnableWindowsFormsHighDpiAutoResizing=true" />
  </runtime>
</configuration>
